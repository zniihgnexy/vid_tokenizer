+def capture_codec_adapter_tokens(output_dir, name, logger, model, loader, task):
+    """Pathway B-mid: codec -> CodecAdapter -> ALL InternViT layers ->
+    pixel_shuffle -> mlp1 -> save [M, 256, 4096] LLM-shaped tokens.
