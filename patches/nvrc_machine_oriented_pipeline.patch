+    --qa-tokens <path>`` can ingest the file unchanged. Output payload:
+        {'idx': LongTensor[M, 3], 'tokens': FP16Tensor[M, 256, 4096]}
+    """
+    adapter = getattr(task, 'codec_adapter', None)
+    teacher = getattr(task, 'teacher_adapter', None)
+    if adapter is None or teacher is None or getattr(teacher, 'vlm', None) is None:
+        return
+    vlm = teacher.vlm
+    model.eval(); adapter.eval()
+    all_idx, all_tokens = [], []
+    with torch.no_grad():
+        for batch in loader:
+            inputs, _ = task.parse_batch(batch)
+            _ = model(inputs, compute_outputs=True, compute_rates=False)
+            feature = task._get_decoder_feature(model)
+            if feature is None:
+                continue
+            patch_embeds = adapter(feature.to(next(adapter.parameters()).dtype))
+            # codec -> full vision tower + projector -> LLM-space tokens
+            # (InternVL: [B,256,4096]; InstructBLIP: [B,32,4096])
+            tokens = vlm.codec_to_llm_tokens(patch_embeds)
+            n_b, t_b = feature.shape[0], feature.shape[1]
+            idx = inputs['idx'].detach().cpu()
+            for s in range(n_b):
+                for sub in range(t_b):
+                    all_idx.append(idx[s].tolist())
+                    all_tokens.append(
+                        tokens[s * t_b + sub].detach().to(torch.float16).cpu()
+                    )
