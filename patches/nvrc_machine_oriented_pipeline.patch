--- upstream/token_head.py	1970-01-01 01:00:00
+++ ours/token_head.py	2026-05-18 19:15:13
@@ -0,0 +1,91 @@
+"""Pathway B token head.
+
+A small trainable module that turns the INR's internal pre-RGB feature layer
+(HiNeRV's ``last_decoder_feature``) into VLM token embeddings, so the codec can
+feed a downstream vision-language model directly without ever reconstructing
+pixels.
+
+The output token grid and width are chosen to match InternVL2.5-8B's visual
+token contract: 256 tokens per frame, each a 4096-d vector in the language
+model's embedding space.
+"""
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+# InternVL2.5-8B: num_image_token = 256 per tile, llm hidden = 4096.
+INTERNVL_TOKENS_PER_FRAME = 256
+INTERNVL_LLM_HIDDEN = 4096
+
+
+class TokenHead(nn.Module):
+    """Map a per-frame INR feature map to VLM token embeddings.
+
+    Input  : ``[N, T, H, W, C]`` — HiNeRV's pre-RGB feature (NTHWC layout).
+    Output : ``[N * T, tokens_per_frame, llm_hidden]`` — one token sequence
+             per frame, ready to be injected at the VLM's ``<IMG_CONTEXT>``
+             positions.
+    """
+
+    def __init__(
+        self,
+        in_channels,
+        hidden_channels=256,
+        tokens_per_frame=INTERNVL_TOKENS_PER_FRAME,
+        llm_hidden=INTERNVL_LLM_HIDDEN,
+    ):
+        super().__init__()
+        token_grid = int(round(tokens_per_frame ** 0.5))
+        assert token_grid * token_grid == tokens_per_frame, \
+            'tokens_per_frame must be a perfect square'
+        self.in_channels = int(in_channels)
+        self.hidden_channels = int(hidden_channels)
+        self.tokens_per_frame = int(tokens_per_frame)
+        self.llm_hidden = int(llm_hidden)
+        self.token_grid = token_grid
+
+        self.proj = nn.Sequential(
+            nn.Conv2d(self.in_channels, self.hidden_channels, kernel_size=3, padding=1),
+            nn.GELU(),
+            nn.Conv2d(self.hidden_channels, self.hidden_channels, kernel_size=3, padding=1),
+            nn.GELU(),
+        )
+        # 1x1 conv projects each spatial cell to the LLM embedding width.
+        self.to_tokens = nn.Conv2d(self.hidden_channels, self.llm_hidden, kernel_size=1)
+
+    def forward(self, feature):
+        assert feature.ndim == 5, \
+            f'expected [N, T, H, W, C], got {tuple(feature.shape)}'
+        n, t, h, w, c = feature.shape
+        assert c == self.in_channels, \
+            f'feature channels {c} != configured in_channels {self.in_channels}'
+
+        # NTHWC -> (N*T, C, H, W)
+        x = feature.permute(0, 1, 4, 2, 3).reshape(n * t, c, h, w).contiguous()
+        x = self.proj(x)
+        # Pool to the fixed token grid regardless of patch spatial size.
+        x = F.adaptive_avg_pool2d(x, (self.token_grid, self.token_grid))
+        x = self.to_tokens(x)  # [N*T, llm_hidden, grid, grid]
+        # [N*T, llm_hidden, grid, grid] -> [N*T, tokens_per_frame, llm_hidden]
+        x = x.flatten(2).transpose(1, 2).contiguous()
+        return x
+
+
+def _smoke_test():
+    """Shape check: a fake INR feature must produce InternVL-shaped tokens."""
+
+    n, t, h, w, c = 2, 4, 12, 12, 35
+    head = TokenHead(in_channels=c)
+    feature = torch.randn(n, t, h, w, c)
+    tokens = head(feature)
+    expected = (n * t, INTERNVL_TOKENS_PER_FRAME, INTERNVL_LLM_HIDDEN)
+    assert tuple(tokens.shape) == expected, (tuple(tokens.shape), expected)
+    n_params = sum(p.numel() for p in head.parameters())
+    print(f'[token_head smoke] input {(n, t, h, w, c)} -> tokens {tuple(tokens.shape)}')
+    print(f'[token_head smoke] params = {n_params:,}')
+    print('[token_head smoke] PASS')
+
+
+if __name__ == '__main__':
+    _smoke_test()
