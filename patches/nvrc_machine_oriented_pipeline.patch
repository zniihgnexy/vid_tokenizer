diff -ruN -x .git -x __pycache__ upstream/codec_to_vit_adapter.py ours/codec_to_vit_adapter.py
--- upstream/codec_to_vit_adapter.py	1970-01-01 01:00:00
+++ ours/codec_to_vit_adapter.py	2026-10-21 09:23:39
@@ -0,0 +1,185 @@
+"""Pathway B-mid: codec feature -> InternViT patch embeddings.
+
+The CodecAdapter maps HiNeRV's internal pre-RGB feature [N, T, H, W, C_in]
+into something shaped exactly like InternViT's patch-embedding output
+[N*T, num_patches, hidden]. That tensor is then routed through the *first
+``num_layers`` blocks* of a frozen InternViT encoder, so the codec is
+explicitly trained to produce a representation that the VLM can read at
+depth.
+
+A parallel oracle path runs the same patch (as a real RGB frame) through the
+same frozen InternViT and exposes its layer-N hidden state. The training
+loss aligns the two hidden states with smooth-L1 + (1 - cosine).
+"""
+
+from __future__ import annotations
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+
+class CodecAdapter(nn.Module):
+    """Project INR pre-RGB feature [N, T, H, W, C_in] to ViT-shaped patch
+    embeddings [N*T, num_patches, hidden_dim].
+
+    The output is in the exact shape and meaning of InternViT's
+    ``embeddings.patch_embedding`` output (pre CLS / pos-embed), so a frozen
+    InternViT encoder can read it directly.
+    """
+
+    def __init__(self, in_channels: int, num_patches: int, hidden_dim: int,
+                 mid_channels: int = 256):
+        super().__init__()
+        grid = int(round(num_patches ** 0.5))
+        assert grid * grid == num_patches, \
+            f'num_patches must be a perfect square (got {num_patches})'
+        self.in_channels = int(in_channels)
+        self.num_patches = int(num_patches)
+        self.hidden_dim = int(hidden_dim)
+        self.grid = grid
+        self.mid_channels = int(mid_channels)
+
+        self.proj = nn.Sequential(
+            nn.Conv2d(self.in_channels, self.mid_channels, kernel_size=3, padding=1),
+            nn.GELU(),
+            nn.Conv2d(self.mid_channels, self.mid_channels, kernel_size=3, padding=1),
+            nn.GELU(),
+        )
+        self.to_hidden = nn.Conv2d(self.mid_channels, self.hidden_dim, kernel_size=1)
+        self.out_norm = nn.LayerNorm(self.hidden_dim)
+
+    def forward(self, feature: torch.Tensor) -> torch.Tensor:
+        assert feature.ndim == 5, \
+            f'expected [N, T, H, W, C], got {tuple(feature.shape)}'
+        n, t, h, w, c = feature.shape
+        assert c == self.in_channels, \
+            f'feature channels {c} != configured in_channels {self.in_channels}'
+        x = feature.permute(0, 1, 4, 2, 3).reshape(n * t, c, h, w).contiguous()
+        x = self.proj(x)
+        x = F.adaptive_avg_pool2d(x, (self.grid, self.grid))
+        x = self.to_hidden(x)
+        x = x.flatten(2).transpose(1, 2).contiguous()
+        return self.out_norm(x)
+
+
+class DeltaAdapter(nn.Module):
+    """Frozen CodecAdapter base + a tiny per-video trainable delta (E-01, 2026-10-04).
+
+    mode: 'film' | 'loraR' | 'film+loraR'. Only the delta parameters train; the base is
+    shared across videos (receiver-side) and the delta is what the bitstream must carry.
+    Forward reproduces CodecAdapter.forward with the delta inserted at the 1x1 projection.
+    """
+
+    def __init__(self, base: 'CodecAdapter', mode: str):
+        super().__init__()
+        self.base = base
+        for p in self.base.parameters():
+            p.requires_grad = False
+        self.mode = mode
+        parts = set(mode.split('+'))
+        self.use_film = 'film' in parts
+        rank = [int(p[4:]) for p in parts if p.startswith('lora')]
+        self.rank = rank[0] if rank else 0
+        hid, mid = base.hidden_dim, base.mid_channels
+        if self.use_film:
+            self.film_scale = nn.Parameter(torch.ones(1, hid, 1, 1))
+            self.film_shift = nn.Parameter(torch.zeros(1, hid, 1, 1))
+        if self.rank:
+            self.lora_a = nn.Conv2d(mid, self.rank, kernel_size=1, bias=False)
+            self.lora_b = nn.Conv2d(self.rank, hid, kernel_size=1, bias=False)
+            nn.init.kaiming_uniform_(self.lora_a.weight, a=5 ** 0.5)
+            nn.init.zeros_(self.lora_b.weight)          # delta starts at exactly zero
+
+    # --- what the bitstream has to carry
+    def delta_state_dict(self):
+        return {k: v for k, v in self.state_dict().items() if not k.startswith('base.')}
+
+    def delta_num_params(self):
+        return sum(v.numel() for v in self.delta_state_dict().values())
+
+    def delta_int8_bytes(self):
+        """Conservative accounting: every delta scalar as one int8 byte, no entropy coding."""
+        return self.delta_num_params()
+
+    def forward(self, feature: torch.Tensor) -> torch.Tensor:
+        b = self.base
+        n, t, h, w, c = feature.shape
+        x = feature.permute(0, 1, 4, 2, 3).reshape(n * t, c, h, w).contiguous()
+        x = b.proj(x)
+        x = F.adaptive_avg_pool2d(x, (b.grid, b.grid))
+        y = b.to_hidden(x)
+        if self.rank:
+            y = y + self.lora_b(self.lora_a(x))
+        if self.use_film:
+            y = y * self.film_scale + self.film_shift
+        y = y.flatten(2).transpose(1, 2).contiguous()
+        return b.out_norm(y)
+
+
+def add_cls_and_pos(vit_embeddings, patch_embeds: torch.Tensor,
+                    grid: int) -> torch.Tensor:
+    """Prepend CLS and add InternViT's position embedding to patch_embeds.
+
+    Mirrors ``InternVisionEmbeddings.forward`` but starts from already-projected
+    patch embeddings (so the codec branch can skip patch_embedding conv).
+    """
+    target_dtype = patch_embeds.dtype
+    batch = patch_embeds.shape[0]
+    cls = vit_embeddings.class_embedding.expand(batch, 1, -1).to(target_dtype)
+    x = torch.cat([cls, patch_embeds], dim=1)
+    pos = vit_embeddings.position_embedding
+    if pos.shape[1] == x.shape[1]:
+        pos_eff = pos
+    else:
+        pos_eff = torch.cat([
+            pos[:, :1, :],
+            vit_embeddings._get_pos_embed(pos[:, 1:, :], grid, grid),
+        ], dim=1)
+    return x + pos_eff.to(target_dtype)
+
+
+def run_first_n_layers(vit_encoder, hidden_states: torch.Tensor,
+                       num_layers: int) -> torch.Tensor:
+    """Forward through the first ``num_layers`` of InternViT encoder.
+
+    The encoder's parameters stay frozen, but gradients still flow to inputs.
+    """
+    out = hidden_states
+    for layer in vit_encoder.layers[:num_layers]:
+        out = layer(out)
+        if isinstance(out, tuple):
+            out = out[0]
+    return out
+
+
+@torch.no_grad()
+def forward_oracle_first_n_layers(vision_model, pixel_values: torch.Tensor,
+                                  num_layers: int) -> torch.Tensor:
+    """Run real RGB frames through InternViT.embeddings + first N encoder
+    layers. Returns layer-N hidden state shaped [B, 1 + num_patches, hidden].
+
+    Always under ``no_grad`` — this is the oracle target.
+    """
+    target_dtype = vision_model.embeddings.patch_embedding.weight.dtype
+    pixel_values = pixel_values.to(target_dtype)
+    h = vision_model.embeddings(pixel_values=pixel_values)
+    return run_first_n_layers(vision_model.encoder, h, num_layers)
+
+
+def detect_vit_dims(vision_model) -> dict:
+    """Return {num_patches, hidden_dim, num_layers, image_size, patch_size}."""
+    emb = vision_model.embeddings
+    num_patches = int(emb.num_patches)
+    hidden_dim = int(emb.embed_dim)
+    image_size = int(emb.image_size)
+    patch_size = int(emb.patch_size)
+    num_layers = len(vision_model.encoder.layers)
+    return {
+        'num_patches': num_patches,
+        'hidden_dim': hidden_dim,
+        'num_layers': int(num_layers),
+        'image_size': image_size,
+        'patch_size': patch_size,
+        'grid': image_size // patch_size,
+    }
