+def _load_internvl_model(model_path=_INTERNVL_MODEL_PATH):
+    """Load InternVL2.5, keep the vision tower + mlp1 projector, drop the LLM.
+
+    The full chat model is loaded in bf16 to bound transient memory; the 7B
+    language model is dropped (it is needed neither for the Phase 1 pooled
+    feature nor for the Phase 2 token extraction) and the kept ~300M-param
+    vision stack is converted to fp32 to match codec training. The returned
+    object still exposes ``vision_model``, ``mlp1`` and ``extract_feature``.
+    """
+    import contextlib
+    import sys
+
+    from transformers import AutoModel
+
+    # InternVL's remote modeling code prints flash-attn notices straight to
+    # stdout at construction time. The codec's smoke step requires stdout to be
+    # pure JSON, so redirect those prints to stderr while loading.
+    with contextlib.redirect_stdout(sys.stderr):
+        model = AutoModel.from_pretrained(
+            model_path,
+            torch_dtype=torch.bfloat16,
+            trust_remote_code=True,
+            low_cpu_mem_usage=True,
+        )
+    if hasattr(model, 'language_model'):
+        del model.language_model  # not used for feature / token extraction
+    model = model.float()
+    model.eval()
+    for param in model.parameters():
+        param.requires_grad = False
+    return model
