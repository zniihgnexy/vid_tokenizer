@@ -0,0 +1,24 @@
+# Pathway B-mid: machine-only codec with InternViT layer-N hidden-state
+# alignment. Pixel L1 is kept at a tiny weight (loss=[0.01, l1] -- the 0.01
+# is the loss-side weight) as an anti-collapse anchor. Override `lamb` to
+# sweep the rate-distortion curve.
+loss: [0.01, l1]
+metric: [psnr, teacher-mse]
+color_space: RGB
+# Default rate point; rate-sweep variants live in
+# l1_teacher-pathway-b-mid-rate{lo,mid,hi}.yaml.
+lamb: 1.0
+enable_log: false
+teacher_enable: true
+teacher_type: internvit
+# Disable both pixel-domain teacher feature loss and the old token-consistency
+# loss; the new hidden-state alignment supersedes both.
+teacher_loss_weight: 0.0
+teacher_detach_target: true
+teacher_token_consistency: false
+teacher_token_consistency_weight: 0.0
+# New: hidden-state consistency at InternViT layer N=12 (mid of 24).
+teacher_hidden_consistency: true
+teacher_hidden_consistency_weight: 1.0
+teacher_hidden_layer_index: 12
+teacher_hidden_cos_weight: 0.0
